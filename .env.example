# Copy this file to .env and fill in real values before running the app.

# Flask application secret (use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-secret-key

# Database
# For local development use SQLite:
DATABASE_URL=sqlite:///numeraid.db
# For PostgreSQL (example):
# DATABASE_URL=postgresql://username:password@localhost:5432/numeraid

# Google Gemini API key (used for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Uploads
UPLOAD_FOLDER=uploads/medical_proofs

# Mail configuration (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_or_app_password
MAIL_DEFAULT_SENDER=your_email@example.com

# Optional runtime settings
# FLASK_ENV=development
# DEBUG=True
